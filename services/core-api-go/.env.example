# Port core-api. Konvensi SIMHA: 3346 core-api, 3347 TCP alat GPS, 5550 HTTP IoT, 3348 AI Brain, 8881 React (dev)
HTTP_ADDR=:3346
# Akun LAYANAN core_api (hak minimum). Format pgx: TANPA ?schema=public
DATABASE_URL=postgres://core_api:<PASSWORD>@192.168.2.47:5432/simha?sslmode=disable
# Kunci PRIVAT RS256 (RAHASIA). Dibuat dengan: go run ./tools/keygen
JWT_PRIVATE_KEY_FILE=keys/core_private.pem
JWT_ISSUER=simha-core
JWT_AUDIENCE=simha-api
# Umur sesi (ADR 0002): access 15 menit; refresh habis bila 7 hari tidak dipakai, maks. 30 hari
ACCESS_TOKEN_TTL=15m
REFRESH_IDLE_TTL=168h
REFRESH_MAX_TTL=720h
# Akun dikunci 15 menit setelah 5 kali login gagal berturut-turut
MAX_FAILED_LOGINS=5
LOGIN_LOCK_DURATION=15m
# release = log debug Gin tidak bercampur dengan log JSON
GIN_MODE=release

# F5 Jadwal laporan: PDF dibuat Chrome/Edge tanpa layar dari halaman cetak frontend, dikirim email.
REPORT_SCHEDULER=true
FRONTEND_URL=http://localhost:8881/operans
# kosong = cari Chrome/Edge otomatis
PDF_BROWSER_PATH=
# kosong = email belum diatur (pengiriman dicatat gagal; tombol Preview PDF tetap bisa)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
