HTTP_ADDR=:3347
# Port TCP untuk Teltonika (isi Port yang sama di Configurator → GPRS → Server Settings)
TCP_ADDR=:5550
# true = catat paket TCP mentah (hex) di log. Nyalakan hanya saat menyetel alat baru.
TCP_LOG_RAW=false
# Database SIMHA sendiri (BUKAN fms_lite). Format pgx: TANPA ?schema=public
DATABASE_URL=postgres://iot_ingest:<PASSWORD>@192.168.2.47:5432/simha?sslmode=disable
# Kunci PUBLIK RS256 milik core-api (ADR 0002). Development: dibuat oleh `go run ./tools/keygen` di core-api (salin core_public.pem)
JWT_PUBLIC_KEY_FILE=keys/dev_public.pem
JWT_ISSUER=simha-core
JWT_AUDIENCE=simha-api
MAX_HISTORY_RANGE_HOURS=24
MAX_HISTORY_ROWS=1000
# Asal halaman yang boleh membuka WebSocket /ws/live (pisahkan dengan koma). Di belakang Nginx satu domain, cukup domain itu.
WS_ALLOWED_ORIGINS=localhost:*,127.0.0.1:*
WS_MAX_CONNECTIONS=500
# release = log debug Gin (daftar route, peringatan) tidak bercampur dengan log JSON kita
GIN_MODE=release
# Fase C1: muat ulang penuh data induk core bila tidak ada NOTIFY (menit)
MASTERDATA_REFRESH_MINUTES=10

# Fase C5: notifikasi WhatsApp alert lewat server WA yang sama dengan sistem lama (POST {number, message}).
# KOSONGKAN selama uji (simulator terdaftar di project asli) agar tidak mengirim ke nomor sungguhan.
WHATSAPP_API_URL=
WHATSAPP_TIMEOUT_MS=10000
WHATSAPP_MAX_ATTEMPTS=3
# Unit tanpa data selama ini (menit) → status offline di peta live
OFFLINE_AFTER_MINUTES=10

# Unit bertipe PERCENTAGE (sensor ECU): ID AVL yang membawa persen level tangki. 89 = "Fuel Level %" (dokumentasi Teltonika).
# Ganti di sini bila di alat memakai ID lain (cek di Teltonika Configurator → I/O). 0 = tidak dibaca.
FUEL_PERCENT_IO_ID=89
