# Salin menjadi .env (tidak masuk Git). Nama variabel tidak peka huruf besar/kecil.

# Database SIMHA sendiri (BUKAN fms_lite), schema `ai`. Format psycopg: TANPA ?schema=public
DATABASE_URL=postgresql://ai_app:<PASSWORD>@192.168.2.47:5432/simha?sslmode=disable

# Kunci PUBLIK RS256 milik core-api (ADR 0002). Salin core_public.pem dari core-api ke folder keys/.
JWT_PUBLIC_KEY_FILE=keys/core_public.pem
JWT_ISSUER=simha-core
JWT_AUDIENCE=simha-api

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Folder penyimpanan file PDF SOP (rahasia perusahaan: jangan masuk Git, jangan dilayani langsung oleh web)
STORAGE_DIR=storage
MAX_UPLOAD_MB=25

# OCR untuk PDF hasil scan (opsional, berat di CPU). Pasang dulu: pip install -e ".[ocr]"
OCR_ENABLED=false
